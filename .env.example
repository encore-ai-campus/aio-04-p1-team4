# Kakao REST API KEY
MAP_API_KEY = 'kakao api key'
KAKAO_JAVASCRIPT_KEY='kakao javascript key'

# Gemini (Google AI Studio)
# 무료 티어 키는 https://aistudio.google.com 에서 발급한다.
GEMINI_API_KEY = 'Gemini api key'
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
# 5단계: 답변 구성 추가 호출만 제어한다. 실패하면 기존 서버 답변을 사용한다.
GEMINI_NARRATION_ENABLED=true
GEMINI_NARRATION_TIMEOUT_SECONDS=8
GEMINI_MAX_COMPLETION_TOKENS=2048
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100

APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false

# Supabase DB
host = ""
port = 5432
dbname = "postgres"
user = ""
password = ""
SUPABASE_URL = ""
SUPABASE_PUBLISHABLE_KEY = "" # API KEY
SUPABASE_DB_URL = ""
