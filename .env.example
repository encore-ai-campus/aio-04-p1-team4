# Kakao REST API KEY
MAP_API_KEY = 'kakao api key'
KAKAO_JAVASCRIPT_KEY='kakao javascript key'

# Groq
GROQ_API_KEY='groq api key'
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
# 5단계: 답변 구성 추가 호출만 제어한다. 실패하면 기존 서버 답변을 사용한다.
GROQ_NARRATION_ENABLED=true
GROQ_NARRATION_TIMEOUT_SECONDS=8
GROQ_MAX_COMPLETION_TOKENS=1024
CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=100

APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false

# Supabase DB
host = ""
port = 5432
dbname = "postgres"
user = ""
password = ""
SUPABASE_URL = ""
SUPABASE_PUBLISHABLE_KEY = "" # API KEY
SUPABASE_DB_URL = ""
